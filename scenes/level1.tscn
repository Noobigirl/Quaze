script/source = "extends level

# This value represents your progress (0.0 = 0%, 1.0 = 100%)
var progress := 0.0
var circuit_animaiion:= false
var test
var scene_tree
var path2d
var line2d
var placeholders:int= 0


func _ready():
	super._ready()
	scene_tree = get_tree()
	test = scene_tree.get_nodes_in_group(\"cable\")
