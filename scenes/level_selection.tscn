[sub_resource type="GDScript" id="GDScript_gswpo"]
script/source = "extends HBoxContainer

func _ready() -> void:
	$Button.pivot_offset = Vector2(27.5, 60)
	$Button2.pivot_offset = Vector2(27.5, 60)


func _on_button_pressed() -> void:
	pass # Replace with function body.
"

[sub_resource type="GDScript" id="GDScript_3rh63"]
script/source = "extends Button_animation

func _on_mouse_entered() -> void:
	super._ease_in()
	$\"../../button_sound\".play()
	
func _on_mouse_exited() -> void:
	super._ease_out()


func _on_pressed() -> void:
	Toolbar.level_changed.emit() 
	get_tree().change_scene_to_file(GlobalGates.levels[0])
	GlobalGates.current_level = 0
"

